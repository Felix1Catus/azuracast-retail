#!/bin/bash

# Installs from before the rebrand may start this image with their previous compose file and env until
# ./docker.sh update has migrated them (docs/retail/REBRAND.md). Keep them working:
#  - database and user still carry the original project's name (the image default is now "acacia")
#  - volumes mounted under the original project's folder instead of /var/acacia
#  - paths stored before the database migration ran resolve through a link to /var/acacia
OLD_NAME=azuracast  # rebrand:keep
OLD_ROOT="/var/${OLD_NAME}"
if [ -d "/var/lib/mysql/${OLD_NAME}" ] && [ ! -d "/var/lib/mysql/${MYSQL_DATABASE:-acacia}" ]; then
  export MYSQL_DATABASE="$OLD_NAME" MYSQL_USER="$OLD_NAME"
  echo "** Using the database from before the rebrand."
fi
for sub in stations backups storage/uploads storage/acme storage/geoip storage/rsas storage/sftpgo storage/shoutcast2 storage/stereo_tool; do
  if mountpoint -q "$OLD_ROOT/$sub" && ! mountpoint -q "/var/acacia/$sub"; then
    if rmdir "/var/acacia/$sub" 2>/dev/null || [ ! -e "/var/acacia/$sub" ]; then
      mkdir -p "$(dirname "/var/acacia/$sub")" && ln -s "$OLD_ROOT/$sub" "/var/acacia/$sub"
      echo "** /var/acacia/$sub -> volume mounted the old way."
    fi
  fi
done
[ -e "$OLD_ROOT" ] || ln -s /var/acacia "$OLD_ROOT"
# Station process configs are generated files in the station volume and still name the old user and paths;
# supervisord refuses to start with an unknown user, so fix them before it reads them (the app rewrites them
# completely on the next station restart).
for conf in /var/acacia/stations/*/config/supervisord.conf; do
  [ -f "$conf" ] || continue
  if grep -q "$OLD_NAME" "$conf"; then
    sed -i -e "s/^user=${OLD_NAME}\$/user=acacia/" -e "s#${OLD_ROOT}/#/var/acacia/#g" "$conf"
    echo "** Updated $conf for the rebrand."
  fi
done
OLD_PREFIX="$(echo "$OLD_NAME" | tr '[:lower:]' '[:upper:]')_"
for var in $(compgen -e | grep "^${OLD_PREFIX}"); do
  new="ACACIA_${var#"$OLD_PREFIX"}"
  [ -n "${!new:-}" ] || export "$new=${!var}"
done

# Write environment variables to script
declare -p | grep -Ev 'BASHOPTS|BASH_VERSINFO|EUID|PPID|SHELLOPTS|UID' > /container.env
chmod 744 /container.env

# Run startup scripts
for f in /etc/my_init.d/*.sh; do
  echo "** Running startup script '$f'..."
  bash "$f" -H
  echo "** Startup script complete."
done

echo "** Running Supervisord..."

if [ "$1" = '--no-main-command' ]; then
    exec supervisord -c /etc/supervisor/supervisord-full.conf --nodaemon
fi

supervisord -c /etc/supervisor/supervisord-minimal.conf

echo "** Supervisord started."
echo "** Running uptime_wait..."

uptime_wait redis || exit 1
uptime_wait db || exit 1

echo "** Services up and ready!"

exec "$@"
